# =============================================================
# InvoiceExtractor - Environment Variables Template
# Copiaza acest fisier in .env.local si completeaza valorile
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Site URL (localhost in dev, domeniu real in productie) ---
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Resend (email) ---
RESEND_API_KEY=re_...

# --- Supabase Vault (cheie pgcrypto pentru integratii criptate) ---
SUPABASE_VAULT_KEY=your-random-32-char-secret-key

# --- DB Password (pentru Supabase CLI local, nefolosit in app) ---
sb_pass=your-db-password
